NODE_ENV=development
PORT=4000

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=gifty
DB_USER=gifty_user
DB_PASSWORD=gifty_pass

# JWT
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=7d

# 결제 (포트원 V2) - 콘솔 > 결제 연동 > 식별코드·API Keys > V2 API 탭에서 확인
# 비워두면(또는 예시값 그대로면) mock 모드로 동작한다.
PORTONE_V2_API_SECRET=your_test_v2_api_secret

# 카카오 소셜 로그인 (선택)
KAKAO_CLIENT_ID=
KAKAO_REDIRECT_URI=
